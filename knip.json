{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**",
    "src/benchmarks/**/*.ts",
    "src/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "eslint-config-next"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "off"
  }
}
